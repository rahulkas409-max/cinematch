# The ₹9 paywall is OFF by default: everything is free and the Razorpay
# endpoints are disabled. Set to true to turn the paywall back on.
ENABLE_PAYWALL=false

# Razorpay — only used when ENABLE_PAYWALL=true (https://dashboard.razorpay.com/app/website-app-settings/api-keys)
# Use rzp_test_… keys for test mode. Leave both empty to run in Sandbox Mode,
# where the ₹9 unlock is simulated instantly.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# TMDB (https://www.themoviedb.org/settings/api) — v3 API key or v4 read token.
# Optional: enables real posters, trailers, live ratings and India streaming providers.
TMDB_API_KEY=

# Optional: SQLite file location (defaults to ./.data/cinematch.db)
# DATABASE_PATH=
